const googleCalendarUrl = 'https://calendar.google.com/calendar/render?action=TEMPLATE&text=Great%20Lakes%20Hackathon%20Challenge%20-%20Info%20Session&dates=20261126T223000Z%2F20261126T233000Z&details=Great%20Lakes%20Hackathon%20in-person%20info%20session%2C%20Thursday%20November%2026%20at%205%3A30%20PM%20Eastern.%20Joyce%20Entrepreneurship%20Centre%2C%202nd%20Floor%2C%20next%20to%20the%20University%20of%20Windsor%20Engineering%20Building.%20One-hour%20calendar%20hold%3B%20actual%20end%20time%20not%20confirmed.%20More%3A%20https%3A%2F%2Fraeonhacks.com%2F&location=Joyce%20Entrepreneurship%20Centre%2C%202nd%20Floor%2C%202455%20Wyandotte%20Street%20West%2C%20Windsor%2C%20Ontario%2C%20Canada&trp=false';
---
