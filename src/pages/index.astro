---
import '../styles/glhc003.css';
import config from '../../public/site-config.js?raw';
const registrationUrl = config.match(/lumaUrl:\s*'([^']+)'/)?.[1];
if (!registrationUrl || !registrationUrl.startsWith('https://luma.com/')) throw new Error('A valid organizer Luma destination is required.');
---
<!doctype html>
<html lang="en" class="static-motion">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#062f42" />
    <script is:inline>
      document.documentElement.classList.add('intro-active');
      // Select layout before body parsing so native scroll restoration sees
      // the final chapter heights; no-JavaScript readers retain the static layout.
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.classList.remove('static-motion');
      }
    </script>
    <meta name="description" content="Make waves with real Great Lakes data. A student hackathon for every skill level, with equipment provided and CASH Prizes." />
    <title>Great Lakes Hackathon Challenge</title>
    <link rel="preload" href="/assets/team-lab.webp" as="image" fetchpriority="high" />
    <link rel="preload" href="/fonts/google-sans/google-sans-latin.woff2" as="font" type="font/woff2" crossorigin />
    <script is:inline src="/site-config.js"></script>
  </head>
  <body>
    <div class="intro-preloader" id="intro-preloader" role="status" aria-live="polite" hidden><p><strong>Into art, science, technology, or just curious? This event is for you.</strong></p></div>
    <script is:inline>
      // Independent of the scene module: even a blocked/failed 3D load must
      // never strand the reader behind the introduction.
      (() => {
        const root = document.documentElement;
        const intro = document.getElementById('intro-preloader');
        const reduced = matchMedia('(prefers-reduced-motion: reduce)');
        const content = [];
        intro.hidden = false;
        const finish = () => {
          intro.hidden = true;
          root.classList.remove('intro-active');
          for (const [element, wasInert] of content) element.inert = wasInert;
        };
        setTimeout(() => {
          intro.classList.add('is-leaving');
          setTimeout(finish, reduced.matches ? 0 : 700);
        }, 6000);
        document.addEventListener('DOMContentLoaded', () => {
          if (!root.classList.contains('intro-active')) return;
          for (const element of document.body.children) {
            if (element === intro || element.tagName === 'SCRIPT') continue;
            content.push([element, element.inert]);
            element.inert = true;
          }
        }, { once: true });
      })();
    </script>
    <a class="skip-link" href="#challenge">Skip to the challenge</a>
    <header class="site-header">
      <nav aria-label="Main navigation"><a class="button header-register" data-register href={registrationUrl} target="_blank" rel="noopener noreferrer">Attend the info session <span aria-hidden="true">↗</span><span class="sr-only"> on Luma (new tab)</span></a></nav>
    </header>
    <div id="stage" class="lake-stage" aria-hidden="true"><div class="lake-backdrop"></div><canvas id="buoy-canvas"></canvas><div class="fallback-illustration"><img src="/assets/buoy-cutout.webp" alt="" width="172" height="344" /></div><span id="stage-label" hidden>Surface view</span><output id="scene-readout" hidden data-progress="0" data-phase="surface" data-camera-parked="false" data-draw-calls="0" data-triangles="0" data-frame-ms="0"><span id="readout-progress"></span><span id="readout-phase"></span><span id="readout-render"></span></output></div>
    <div id="scene-loading" class="scene-loading" role="status" aria-live="polite" hidden><span id="loading-label">Preparing the lake…</span><button id="scene-retry" type="button" hidden>Retry 3D</button></div>
    <main id="story">
      <section class="invitation chapter" id="invitation" aria-labelledby="invitation-title">
        <div class="hero-copy"><h1 id="invitation-title">Great Lakes<br />Hackathon <em>Challenge</em></h1></div>
        <figure class="hero-photo"><div class="hero-photo__frame"><img src="/assets/team-lab.webp" width="1276" height="960" alt="A group of students and researchers gathered around scientific equipment in a research laboratory." fetchpriority="high" decoding="async" /><span class="prize-burst"><span><strong>CASH</strong>Prizes</span></span><span class="hero-photo__callout"><span>YOUR IDEA COULD BE FEATURED</span><span>AT TOURIST ATTRACTIONS ↗</span></span></div><figcaption class="sr-only">CASH Prizes for top projects.</figcaption></figure>
        <div class="hero-details"><p class="hero-description">Join solo or as a team and bring Great Lakes data to life through lights, sound, interactive dashboards, or something entirely new. We want to see your ideas!</p><p class="hero-dates"><span>Idea Submissions OPEN: Nov 5th.</span><span>Idea Submissions CLOSE: Dec 3rd.</span></p></div>
        <nav class="hero-actions" aria-label="Explore the event"><a class="button hero-jump" href="#surface">What’s this about?</a><a class="button hero-jump" href="#challenge">What’s the challenge?</a></nav>
        <a class="scroll-cue" href="#surface">SCROLL FOR A COOL BREAKDOWN<img src="/assets/scroll_down.svg" alt="" width="48" height="48" aria-hidden="true" /><span class="scroll-cue-static" aria-hidden="true">↓</span></a>
      </section>
      <section class="surface chapter" id="surface" aria-labelledby="surface-title" tabindex="-1">
        <div class="surface-copy editorial-copy"><p class="eyebrow">1/4: At The Surface.</p><h2 id="surface-title">A lake full<br />of questions.</h2><p>Across the Great Lakes, scientists and researchers deploy monitoring equipment to observe how the water is changing.</p></div>
        <figure class="research-photo"><img src="/assets/team-water.webp" alt="Researchers wearing flotation suits aboard a boat with scientific monitoring equipment." width="712" height="950" loading="lazy" decoding="async" /><figcaption>Research begins with people, equipment, and a question.</figcaption></figure>
        <p class="surface-note">Follow the buoy beneath the surface <span aria-hidden="true">↓</span></p>
        <div class="static-buoy"><img src="/assets/buoy-reference.webp" alt="Yellow monitoring buoy with a solar-panel tower and instruments for collecting lake observations." width="600" height="600" loading="lazy" /></div>
      </section>
      <section class="crossing chapter" id="crossing" aria-labelledby="crossing-title"><div class="crossing-copy"><p class="eyebrow">2/4: Beneath The Surface.</p><h2 id="crossing-title">A different<br />perspective.</h2><p>Below the float, scientific instruments help turn the lake’s changing conditions into observations.</p></div></section>
      <section class="science chapter" id="science" aria-label="Understanding the science">
        <div class="science-copy"><div class="science-copy__inner"><p class="eyebrow">3/4: Understanding The Science.</p><div class="panel-window" id="panel-window"><div class="panel-track" id="panel-track">
          <article class="science-panel" id="panel-one"><h2>Signals from<br />the lake.</h2><p>Buoys equipped with scientific sensors collect measurements such as water temperature, dissolved oxygen, and indicators of algal activity. These observations help researchers understand how conditions in the Great Lakes change over time.</p></article>
          <article class="science-panel" id="panel-two"><h2>A shared<br />freshwater future.</h2><p>The Great Lakes support millions of people, provide drinking water, and sustain important ecosystems. Pollution, warming temperatures, and harmful algal blooms can threaten their health. Understanding these changes helps scientists and communities make informed decisions.</p></article>
        </div></div><p class="science-cue" aria-hidden="true">Keep scrolling to follow the story <span>↓</span></p></div></div>
      </section>
      <section class="challenge challenge-rounds chapter" id="challenge" aria-labelledby="challenge-title" tabindex="-1">
        <div class="challenge-intro"><h2 class="eyebrow" id="challenge-title"><span id="how-it-works">4/4: How it works</span></h2></div>
        <article class="challenge-round round-one" aria-labelledby="round-one-title"><h3 id="round-one-title"><span>Round 1 -</span> Submit Your Idea</h3><p class="round-subtitle">Open To Everyone</p><p>Have a creative idea for bringing Great Lakes data to life? We want to hear it!</p><ul><li><strong>Go solo or team up.</strong> Submit individually or with a group.</li><li><strong>All skills welcome.</strong> No coding, design, or technical experience needed.</li><li><strong>Get creative with real data.</strong> Think lights, sound, interactive displays, art, or something entirely new.</li><li><strong>No prototype required.</strong> Just share your idea and how it could work.</li></ul><p class="round-selection"><strong>10 ideas will be selected to advance to Round Two.</strong></p></article>
        <figure class="collage"><h3>There’s inspiration<br />to draw from.</h3><img src="/assets/glhc-communication-collage-640.webp" srcset="/assets/glhc-communication-collage-640.webp 640w, /assets/glhc-communication-collage-1080.webp 1080w" sizes="(min-width: 900px) 48vw, 90vw" width="1080" height="1080" alt="Collage of a green illuminated waterfront installation, an electronics controller with lights, and a purple LED display." loading="lazy" decoding="async" /><figcaption>Light. Hardware. A new way of seeing.<span>Illustrative inspiration for what data can become.</span></figcaption></figure>
        <article class="challenge-round round-two" aria-labelledby="round-two-title"><h3 id="round-two-title"><span>Round 2 -</span> Bring Your Idea to Life</h3><p class="round-subtitle">Build &amp; Showcase</p><p>Selected participants get the resources and support to turn their ideas into reality.</p><ul><li><strong>Receive a project budget.</strong> Funding to help build your idea.</li><li><strong>Access equipment and support.</strong> Get the tools and guidance you need.</li><li><strong>Build your creation.</strong> Transform your concept into a working project.</li><li><strong>Compete for cash prizes.</strong> Top projects will receive cash awards.</li><li><strong>Get featured publicly.</strong> Winning creations will become part of public displays at tourist destinations.</li></ul><p class="round-finale"><strong><em>Your idea could become something thousands of people experience.</em></strong></p></article>
      </section>
      <section class="registration chapter" id="registration" aria-labelledby="registration-title"><div class="registration-inner"><p class="eyebrow">TAKE THE PLUNGE</p><h2 id="registration-title">Your idea could<br />make <em>waves.</em></h2><p class="registration-intro">No experience required. Bring your curiosity, work with a team, and create something worth sharing.</p><p class="registration-prize"><strong>CASH Prizes</strong> for top projects.</p><p>All experience levels welcome.<br />Your project could be showcased in public displays.</p><a class="button button--large" data-register href={registrationUrl} target="_blank" rel="noopener noreferrer">Attend the info session <span aria-hidden="true">↗</span><span class="sr-only"> on Luma (new tab)</span></a><p class="luma-note">Find current event details on Luma.<br />Opens in a new tab.</p></div></section>
    </main>
    <footer class="site-footer"><a href="#invitation">Great Lakes Hackathon Challenge</a><span>Real data. Shared curiosity. New possibilities.</span><label class="motion-toggle"><input id="reduce-motion" type="checkbox" /><span>Less motion</span></label><a href="#invitation">Back to the surface ↑</a></footer>
    <script>import '../scripts/glhc003/bootstrap.js';</script>
  </body>
</html>
